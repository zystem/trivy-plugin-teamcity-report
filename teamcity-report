#!/bin/sh

set -eu # Exit on any non-zero exit code, and error on use of undefined var
# Note that the trivy commands will still exit with code 0 when vulns are detected unless --exit-code is set.

# Usage
usage() {
  cat <<EOS >&2
Usage: trivy teamcity-report [-h,--help] OPERATION TARGET OUTPUTPUTFILE [TRIVYPARAMS]
 A Trivy plugin that exports an html report in a format used for teamcity, and outputs teamcity messages.
Options:
  -h, --help    Show usage.
Examples:
  # Scan an image with default settings
  trivy teamcity-report image python:3.8 output.html
  trivy teamcity-report image nginx:1.27,redis:7,postgres:16 output.html
  # Scan a local dir for vulns and misconfiguration
  trivy teamcity-report fs /path/to/dir output.html --scanners vuln,config
  trivy teamcity-report fs /path/to/dira,/path/to/dirb output.html --scanners vuln,config
  # Scan kubernetes targets
  trivy teamcity-report kubernetes cluster_a output.html
  trivy teamcity-report kubernetes cluster_a,cluster_b output.html
EOS
  exit
}

success_message() {
  printf '\033[0;32m ✔️  %s  \t\033[0m\n' "$1"
}

warning_message() {
  printf '\033[0;33m%s  \t\033[0m\n' "$1"
}

info_message() {
  printf '\033[0;34m%s  \t\033[0m\n' "$1"
}

error_message() {
  printf '\033[0;31m%s  \t\033[0m\n' "$1"
}

scan_single() {
  info_message "Scanning and exporting HTML report to '$output_file'"
  trivy "$trivy_command" --format template --template "@$BASEDIR/html.tpl" --output "$output_file" "$@" "$target"

  info_message "Printing summary:"
  trivy "$trivy_command" --quiet "$@" "$target"

  info_message "Emitting teamcity messages:"
  # Explcitiy use all severities so that reporting of statistic messages is accurate
  trivy "$trivy_command" "$target" --quiet --format json --severity UNKNOWN,LOW,MEDIUM,HIGH,CRITICAL "$@" > "$workdir/report.json"
  "$BASEDIR/export_teamcity_messages.py" < "$workdir/report.json"
}

scan_multi() {
  merged_json="$workdir/merged.json"
  mkdir "$workdir/scans"
  remaining_targets=$target
  idx=0

  while [ -n "$remaining_targets" ]; do
    case "$remaining_targets" in
      *,*)
        item=${remaining_targets%%,*}
        remaining_targets=${remaining_targets#*,}
        ;;
      *)
        item=$remaining_targets
        remaining_targets=
        ;;
    esac
    [ -n "$item" ] || continue

    idx=$((idx + 1))
    json_file=$(printf '%s/scans/%020d.json' "$workdir" "$idx")

    info_message "Scanning $item"

    trivy "$trivy_command" "$item" --quiet --format json --severity UNKNOWN,LOW,MEDIUM,HIGH,CRITICAL "$@" > "$json_file" || {
      error_message "Trivy scan failed for target: $item"
      exit 1
    }
  done

  if [ "$idx" -eq 0 ]; then
    error_message "No valid targets after parsing CSV"
    exit 1
  fi

  info_message "Merging JSON results"

  jq -s '
    . as $docs
    | ($docs[0] // {}) as $first
    | $first + {
        Results: ($docs | map(.Results // []) | add)
      }
  ' "$workdir"/scans/*.json > "$merged_json" || {
    error_message "Failed to merge JSON results"
    exit 1
  }

  info_message "Scanning and exporting HTML report to '$output_file'"
  trivy convert --format template --template "@$BASEDIR/html.tpl" --output "$output_file" "$merged_json" || {
    error_message "Failed to generate HTML from merged JSON"
    exit 1
  }

  info_message "Printing summary:"
  trivy convert --format table "$merged_json" || {
    error_message "Failed to generate summary from merged JSON"
    exit 1
  }

  info_message "Emitting teamcity messages:"
  "$BASEDIR/export_teamcity_messages.py" < "$merged_json"
}

scan() {
  BASEDIR=$(dirname "$0")

  trivy_command="$1"
  info_message "trivy_command = $trivy_command"
  shift

  target="$1"
  info_message "target = $target"
  shift

  output_file="$1"
  info_message "output_file = $output_file"
  shift

  info_message "trivy_params = $*"

  if [ -z "$output_file" ]; then
    error_message "ERROR - no output file specified, please specify.
Example: trivy teamcity-report image affinda/ocr output.html"
    exit 1
  fi

  workdir=$(mktemp -d)
  trap 'rm -rf "$workdir"' 0
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM

  case "$target" in
    *,*) scan_multi "$@" ;;
    *) scan_single "$@" ;;
  esac
}

if [ "$#" -eq 0 ] || [ "${1-}" = "--help" ] || [ "${1-}" = "-h" ]; then
  # No commands or the --help flag passed and we'll show the usage instructions
  usage
fi
if [ "$#" -lt 3 ]; then
  error_message "ERROR - specify OPERATION TARGET OUTPUTFILE"
  exit 1
fi
scan "$@"
